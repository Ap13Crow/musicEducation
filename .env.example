# MyMusic.Coach environment template
#
# Copy to .env for local development. Every sensitive value below is an
# explicit placeholder. Never put production values in this file.

# Application
NODE_ENV=development
PORT=4000
MCP_PORT=3100
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_USER=mymusic_coach
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=mymusic_coach
DATABASE_URL=postgresql://mymusic_coach:local-development-only@localhost:5432/mymusic_coach

# Authentication
JWT_SECRET=replace-with-a-local-random-value
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-local-random-value
KEYCLOAK_CLIENT_ID=mymusic-coach-web
KEYCLOAK_CLIENT_SECRET=replace-with-a-local-client-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/mymusic-coach
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-admin-password

# Web application
GRAPHQL_SERVER_URL=http://localhost:4000/graphql
INTERNAL_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:4000/graphql
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=mymusic-coach-web
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/mymusic-coach
NEXT_PUBLIC_ENABLE_LIVE_API=false

# Stripe test mode only for development
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_CLIENT_ID=ca_replace_me

# Google Workspace / Calendar target architecture
# Point to a credential file stored outside the repository. Do not paste JSON
# credentials or mailbox passwords into an environment file.
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/outside-the-repository/google-service-account.json
GOOGLE_WORKSPACE_CUSTOMER_ID=replace-me
GOOGLE_TEACHERS_CALENDAR_OWNER=teachers@mymusic.coach
GOOGLE_STUDENTS_CALENDAR_OWNER=students@mymusic.coach

# S3-compatible object storage
S3_ENDPOINT=https://s3.example.invalid
S3_REGION=replace-me
S3_BUCKET=mymusic-coach-development
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Optional AI providers
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
CLAUDE_API_KEY=

# Transactional email (Google Workspace SMTP relay) — optional; missing
# SMTP_PASSWORD disables sending cleanly (apps/api/src/lib/mailer.ts).
# The deployed environment's actual HOST/USER/FROM are set in
# .github/workflows/deploy-application.yml, not here — these are safe
# placeholders, not a real mailbox, so a local checkout never accidentally
# sends mail as one.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=replace-me@example.com
SMTP_PASSWORD=
SMTP_FROM=replace-me@example.com
SMTP_FROM_NAME=MyMusic.Coach

# External event discovery — optional; missing key disables the feature cleanly.
# Ticketmaster Discovery API Consumer Key (the Consumer Secret is unused here).
TICKETMASTER_API_KEY=

