generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

// A user whose Keycloak identity no longer exists (deleted by an admin,
// directly in the Keycloak console or via adminDeactivateUser) is marked
// DEACTIVATED rather than deleted here - bookings/payments/history reference
// this row and must survive. See adminDeactivateUser (admin.ts) and the
// worker's keycloak-user-sync job for the two paths that set this.
enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum SkillLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonContentType {
  VIDEO
  YOUTUBE
  AUDIO
  SLIDES
}

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum QuizFeedbackMode {
  IMMEDIATE
  AT_END
}

enum BookingStatus {
  // Also doubles as "awaiting the teacher's manual approval" (see
  // TeacherProfile.autoApproveNewStudents/autoApproveRecurringStudents) -
  // Booking.holdExpiresAt bounds how long a manual-approval request stays
  // blocking the slot for other students while awaiting a decision.
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum EventType {
  MASTERCLASS
  WORKSHOP
  CONCERT
  COMPETITION
  OPEN_MIC
  LECTURE
  OTHER
}

enum EventFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  YAPEAL
}

enum EventBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  ATTENDED
}

enum TeacherApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum CheckoutOrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  COMPLETED
}

enum CheckoutOrderItemType {
  BOOKING
  PACKAGE
  SUBSCRIPTION
  COURSE
  EVENT
}

enum TeacherTransferStatus {
  NOT_REQUIRED
  HELD
  READY
  TRANSFERRED
  FAILED
  REVERSED
}

enum LessonPackagePurchaseStatus {
  ACTIVE
  REFUNDED
  EXPIRED
}

// ── Models ──────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  role          Role      @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Opaque bearer token authenticating the read-only calendar subscription
  // feed (GET /calendar/feed/:token.ics - see apps/api/src/lib/
  // calendarFeed.ts). Calendar apps (Apple Calendar, Google Calendar,
  // Outlook "subscribe from web") poll this URL directly with no session
  // cookie and no OAuth, so the token itself is the credential - null until
  // rotateCalendarFeedToken is first called, and replaceable any time the
  // student/teacher wants to invalidate a previously shared link.
  calendarFeedToken String? @unique

  profile            UserProfile?
  teacherProfile     TeacherProfile?
  teacherApplication TeacherApplication?
  gamification       GamificationProfile?
  externalIdentities UserExternalIdentity[]
  enrollments        Enrollment[]
  bookings           Booking[]
  eventBookings      EventBooking[]
  payments           Payment[]
  checkoutOrders     CheckoutOrder[]
  bookingCarts       BookingCart[]
  assessments        Assessment[]
  feedPosts          FeedPost[]
  feedLikes          FeedLike[]
  feedComments       FeedComment[]
  following          Follow[]               @relation("follower")
  followers          Follow[]               @relation("following")
  reviews             Review[]
  publishedEvents     Event[]
  studentAvailability StudentAvailability[]
  quizAttempts        QuizAttempt[]
  xpAwards            XpAward[]
  personalAppointments PersonalAppointment[]
  lessonPackagePurchases LessonPackagePurchase[]
  subscriptionPurchases  SubscriptionPurchase[]
  externalEventEngagements ExternalEventEngagement[]
  externalCalendarConnections ExternalCalendarConnection[]
}

model UserProfile {
  id             String     @id @default(cuid())
  userId         String     @unique
  displayName    String?
  bio            String?
  avatarUrl      String?
  // Optional second address for transactional email (booking confirmations,
  // etc.), distinct from the account/login email (User.email). Outbox
  // recipients are the unique set of both when both are present.
  notificationEmail String?
  instruments    String[]
  musicStyles    String[]
  skillLevel     SkillLevel @default(BEGINNER)
  city           String?
  country        String?
  language       String     @default("en")
  timezone       String     @default("Europe/Zurich")
  onboardingDone Boolean    @default(false)
  onboardingStep Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model TeacherProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  bio              String?
  instruments      String[]
  musicStyles      String[]
  languages        String[]
  hourlyRate       Decimal? @db.Decimal(10, 2)
  currency         String   @default("CHF")
  // Controls booking eligibility ONLY (bookSession gates on this - see
  // bookings.ts). Directory/search visibility is isPublic, below - the two
  // used to be the same flag, which silently hid a teacher from the whole
  // public directory the moment they paused new bookings.
  isAvailable      Boolean  @default(true)
  // Controls whether this profile appears in the public teacher directory
  // and search (`teachers` query, users.ts) - independent of isAvailable.
  // Defaults to true for real teachers (reviewTeacherApplication/
  // adminSetRole); applyAsTeacher overrides it to false when the caller is
  // an ADMIN self-provisioning a profile, since holding ADMIN isn't itself
  // an expression of intent to be publicly listed as a teacher.
  isPublic         Boolean  @default(true)
  calendlyUsername String?
  avgRating        Float    @default(0)
  totalReviews     Int      @default(0)
  // Copied from the approved TeacherApplication - years teaching, and a
  // YouTube presentation/performance video the teacher can hide again at
  // any time (introVideoVisible) without losing the link itself.
  experienceYears    Int?
  introVideoUrl      String?
  introVideoVisible  Boolean  @default(true)
  // Public professional photo shown on the teacher directory/profile to
  // guests and other users - deliberately separate from UserProfile.avatarUrl
  // (the private account avatar). Set via requestUploadUrl(purpose:
  // TEACHER_PROFILE_IMAGE) + updateTeacherProfile, never reused from the
  // account avatar automatically.
  publicImageUrl     String?
  // Was a hardcoded [] in the TeacherProfile.teachingFormats field resolver
  // (users.ts) - schema.graphql and updateTeacherProfile's arg have existed
  // since teachingFormats was added, but nothing ever stored or returned a
  // real value. Free-form strings matching the BookingFormat vocabulary
  // (IN_PERSON/ONLINE/HYBRID) rather than the enum itself, since a teacher
  // may offer more than one.
  teachingFormats    String[] @default([])
  // Stripe Connect Express account this teacher's share of course/booking/event
  // revenue is transferred to. Null until the teacher completes onboarding.
  stripeAccountId      String?  @unique
  stripePayoutsEnabled Boolean  @default(false)
  // Advance-booking rule (0-7, validated in the resolver): 0 = open until
  // 23:59 in the teacher's timezone on the day before the lesson; 1-7 =
  // closes exactly that many x 24h before the lesson start. Enforced in
  // both slot discovery and bookSession server-side, never only client UI.
  leadDays Int @default(1)
  // Cancellation rule (2-7, validated in the resolver): must be
  // >= leadDays + 1 so a cancelled slot can still be rebooked under the
  // lead-time rule. On-time releases the slot; late/no-show charges the
  // full lesson price or consumes a credit (ledger/credit consumption is
  // Phase 5 - this phase records the on-time/late determination itself).
  cancellationDays Int @default(2)
  // Separate auto/manual approval switches for a brand-new student vs a
  // "recurring" one (has >=1 CONFIRMED/COMPLETED booking with this teacher
  // already - see isRecurringStudent in bookings.ts). Both default to
  // auto-approve, matching today's actual behavior before this migration.
  autoApproveNewStudents      Boolean @default(true)
  autoApproveRecurringStudents Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User                   @relation(fields: [userId], references: [id])
  certifications TeacherCertification[]
  availability   TeacherAvailability[]
  unavailability TeacherUnavailability[]
  instrumentCapacities TeacherInstrumentCapacity[]
  lessonPackageOffers  LessonPackageOffer[]
  lessonPackagePurchases LessonPackagePurchase[]
  subscriptionOffers   SubscriptionOffer[]
  subscriptionPurchases SubscriptionPurchase[]
  courses        Course[]
  bookings       Booking[]
  checkoutOrders CheckoutOrder[]
  bookingCarts   BookingCart[]
}

model TeacherCertification {
  id               String   @id @default(cuid())
  teacherProfileId String
  title            String
  issuingBody      String?
  issuedYear       Int?
  documentUrl      String?
  createdAt        DateTime @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])
}

// A student's self-service request to become a teacher. Approving one is the
// only thing that promotes User.role to TEACHER via this path — admins can
// still promote directly via adminSetRole, but the public "Become a teacher"
// page always goes through this queue for review.
model TeacherApplication {
  id              String                    @id @default(cuid())
  userId          String                    @unique
  headline        String?
  bio             String?
  instruments     String[]
  experienceYears Int?
  // Deprecated (WP26): superseded by the structured fields below - kept as
  // an unused legacy column rather than dropped, matching this codebase's
  // convention for retired columns (see Course.moodleCourseId,
  // EventBooking.pretixOrderCode). No mutation writes to it anymore; the
  // admin review UI reads it read-only, as a fallback display for
  // applications submitted before this change (see the address field on
  // the GraphQL TeacherApplication type).
  address         String?
  // Structured postal address, validated server-side in applyForTeacher
  // (see apps/api/src/resolvers/teacherApplications.ts) - street/houseNumber/
  // postalCode/city/country are required, state is optional (only
  // meaningful for some countries). Splitting these out instead of one
  // free-text line keeps the data usable (sortable/filterable, safe to hand
  // to a shipping/verification API later) rather than an unparseable blob.
  street          String?
  houseNumber     String?
  postalCode      String?
  city            String?
  state           String?
  country         String?
  // Verified server-side (applyForTeacher rejects under-18) - self-employed
  // teachers on the platform must be adults; full identity verification is a
  // later phase, this is the quality/legal floor for now.
  birthdate       DateTime?                 @db.Date
  // Private, admin-review-only - never copied onto the public TeacherProfile.
  gender          String?
  motivation      String?
  // Populated via the /teacher-application/cv, /audio, /document REST
  // endpoints (apps/api/src/index.ts) as a small base64 data: URL saved
  // directly here, no object storage involved - or via requestUploadUrl
  // (purpose: TEACHER_APPLICATION_*, see apps/api/src/lib/storage.ts) on a
  // deployment that does have S3_* configured, in which case this holds a
  // real S3 fileUrl instead. Either way, whatever string is here is the
  // value to link to/download - callers must not assume one format or the
  // other.
  cvUrl           String?
  audioSampleUrl  String?
  documentUrls    String[]                  @default([])
  // Public teacher photo (TEACHER_PROFILE_IMAGE purpose) - copied to
  // TeacherProfile.publicImageUrl on approval. Deliberately separate from
  // UserProfile.avatarUrl (the private account avatar).
  imageUrl        String?
  // YouTube link, not an uploaded file - keeps the site light (see
  // apps/web/src/lib/youtube.ts). Required to apply; copied to
  // TeacherProfile.introVideoUrl on approval.
  videoUrl        String?
  status          TeacherApplicationStatus  @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model TeacherAvailability {
  id               String   @id @default(cuid())
  teacherProfileId String
  dayOfWeek        Int
  startTime        String
  endTime          String
  timezone         String   @default("Europe/Zurich")
  createdAt        DateTime @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])
}

model StudentAvailability {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int      // 0=Sun … 6=Sat
  startTime String   // "HH:MM"
  endTime   String   // "HH:MM"
  timezone  String   @default("Europe/Zurich")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model GamificationProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  xp          Int        @default(0)
  totalPoints Int        @default(0)
  level       Int        @default(1)
  skillLevel  SkillLevel @default(BEGINNER)
  badges      String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum XpAwardReason {
  PROFILE_COMPLETED
  TEACHER_FOUND
  EVENT_ATTENDED
  COURSE_BONUS
}

// Audit ledger for every XP grant outside per-lesson (Lesson.xpReward) and
// assessment (Assessment.xpAwarded) completion, which already increment
// GamificationProfile directly. refId is the idempotency key for the
// automatic one-time reasons (PROFILE_COMPLETED/TEACHER_FOUND use the
// sentinel 'self'; EVENT_ATTENDED uses the event id) - the unique
// constraint below relies on Postgres treating NULL <> NULL, so
// COURSE_BONUS (refId always null) is deliberately exempt and stays
// repeatable, since a teacher/admin may award it more than once.
model XpAward {
  id           String        @id @default(cuid())
  userId       String
  reason       XpAwardReason
  refId        String?
  enrollmentId String?
  amount       Int
  note         String?
  awardedBy    String?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, reason, refId])
  @@index([userId])
}

model UserExternalIdentity {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  externalId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, externalId])
}

model Category {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  courses  Course[]
}

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  description      String?
  shortSummary     String?
  level            SkillLevel   @default(BEGINNER)
  instruments      String[]
  musicStyles      String[]
  price            Decimal      @default(0) @db.Decimal(10, 2)
  currency         String       @default("CHF")
  status           CourseStatus @default(DRAFT)
  isFreeTier       Boolean      @default(false)
  language         String       @default("en")
  thumbnailUrl     String?
  categoryId       String?
  teacherProfileId String?
  moodleCourseId   Int?
  avgRating        Float        @default(0)
  totalReviews     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  teacherProfile TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  sections       CourseSection[]
  enrollments    Enrollment[]
  reviews        Review[]
}

model CourseSection {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int    @default(0)

  course  Course   @relation(fields: [courseId], references: [id])
  lessons Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  sectionId   String
  title        String
  description  String?
  videoUrl     String?
  contentType  LessonContentType @default(VIDEO)
  duration     Int?
  order        Int      @default(0)
  xpReward     Int      @default(10)
  isPreview    Boolean  @default(false)
  feedbackMode QuizFeedbackMode @default(IMMEDIATE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  section       CourseSection    @relation(fields: [sectionId], references: [id])
  progress      LessonProgress[]
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]
  slides        LessonSlide[]
}

// Ordered slide deck for a contentType SLIDES lesson - each slide its own
// uploaded file (image or single-page PDF) in object storage, rather than a
// single PDF split server-side, so per-slide viewing can be tracked without
// a PDF-rendering pipeline.
model LessonSlide {
  id        String   @id @default(cuid())
  lessonId  String
  order     Int      @default(0)
  fileUrl   String
  title     String?
  createdAt DateTime @default(now())

  lesson Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  views  LessonSlideView[]

  @@index([lessonId, order])
}

// Per-slide "viewed" marker for one student's enrollment - drives
// Lesson.myViewedSlideIds and the slide viewer's progress bar. Idempotent
// per (enrollment, slide): viewing a slide again is a no-op, not a new row.
model LessonSlideView {
  id           String   @id @default(cuid())
  enrollmentId String
  slideId      String
  viewedAt     DateTime @default(now())

  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  slide      LessonSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, slideId])
}

model QuizQuestion {
  id          String           @id @default(cuid())
  lessonId    String
  text        String
  type        QuizQuestionType @default(SINGLE_CHOICE)
  points      Int              @default(1)
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lesson  Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]
}

model QuizOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  score       Int       @default(0)
  maxScore    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([userId, lessonId])
}

model QuizAnswer {
  id                String   @id @default(cuid())
  attemptId         String
  questionId        String
  selectedOptionIds String[] @default([])
  isCorrect         Boolean  @default(false)
  pointsAwarded     Int      @default(0)
  answeredAt        DateTime @default(now())

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  paymentId   String?   @unique
  progress    Float     @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User              @relation(fields: [userId], references: [id])
  course         Course            @relation(fields: [courseId], references: [id])
  payment        Payment?          @relation(fields: [paymentId], references: [id])
  lessonProgress LessonProgress[]
  slideViews     LessonSlideView[]

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  lesson     Lesson     @relation(fields: [lessonId], references: [id])

  @@unique([enrollmentId, lessonId])
}

model Assessment {
  id          String    @id @default(cuid())
  userId      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationSec Int?
  skillLevel  String?
  xpAwarded   Int?
  aiReport    String?
  createdAt   DateTime  @default(now())

  user    User               @relation(fields: [userId], references: [id])
  answers AssessmentAnswer[]
}

model AssessmentQuestion {
  id         String   @id @default(cuid())
  category   String
  difficulty String
  instrument String?
  prompt     String
  options    Json?
  createdAt  DateTime @default(now())

  answers AssessmentAnswer[]
}

model AssessmentAnswer {
  id             String   @id @default(cuid())
  assessmentId   String
  questionId     String
  selectedOption String?
  openAnswer     String?
  isCorrect      Boolean?
  createdAt      DateTime @default(now())

  assessment Assessment         @relation(fields: [assessmentId], references: [id])
  question   AssessmentQuestion @relation(fields: [questionId], references: [id])

  // Revisiting a question (e.g. going back a step) must update the existing
  // answer, not add a second row - completeAssessment scores off
  // assessment.answers.length, so a duplicate would inflate totalAnswered
  // and silently skew the resulting score/skill level.
  @@unique([assessmentId, questionId])
}

model Booking {
  id               String        @id @default(cuid())
  userId           String
  teacherProfileId String
  startsAt         DateTime
  endsAt           DateTime?
  durationMin      Int           @default(60)
  format           BookingFormat @default(ONLINE)
  status           BookingStatus @default(PENDING)
  paymentId        String?
  checkoutOrderId  String?
  instrument       String?
  notes            String?
  meetingUrl       String?
  zoomMeetingId    String?
  zoomJoinUrl      String?
  zoomStartUrl     String?
  externalBookingId String?
  // Incremented each time an ICS invitation is regenerated for this booking
  // (confirm, later reschedule) - RFC 5545 requires SEQUENCE to increase on
  // every update so a calendar client applies changes instead of treating a
  // resend as a duplicate. Cancellation reuses the same UID/latest sequence
  // with METHOD:CANCEL (see apps/api/src/lib/ics.ts).
  icsSequence      Int           @default(0)
  // Only set while status is AWAITING_APPROVAL - once passed, the hold no
  // longer blocks the slot for other students (checked lazily in the
  // conflict query, see bookings.ts) and the request is treated as expired
  // rather than left blocking forever.
  holdExpiresAt    DateTime?
  // Set once, on cancellation: true = late (inside cancellationDays) or a
  // no-show, false = on-time. Null until then. Phase 5 owns actually
  // charging/consuming a credit off this determination; this phase records
  // the determination itself.
  lateCancellation Boolean?
  // When set, this booking was made against a prepaid package credit
  // instead of a one-off charge - see apps/api/src/lib/lessonCredits.ts.
  // Plain column, no FK, same pattern as paymentId above.
  packagePurchaseId String?
  subscriptionPurchaseId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  checkoutOrder  CheckoutOrder? @relation(fields: [checkoutOrderId], references: [id])
  cartItems      BookingCartItem[]
  reviews        Review[]
}

model BookingCart {
  id               String   @id @default(cuid())
  userId           String
  teacherProfileId String
  currency         String   @default("CHF")
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id])
  teacherProfile TeacherProfile   @relation(fields: [teacherProfileId], references: [id])
  items          BookingCartItem[]
  checkoutOrder  CheckoutOrder?

  @@index([userId, expiresAt])
  @@index([teacherProfileId, expiresAt])
}

model BookingCartItem {
  id          String        @id @default(cuid())
  cartId      String
  startsAt    DateTime
  endsAt      DateTime
  durationMin Int           @default(60)
  format      BookingFormat @default(ONLINE)
  instrument  String?
  notes       String?
  bookingId   String?
  createdAt   DateTime      @default(now())

  cart    BookingCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  booking Booking?    @relation(fields: [bookingId], references: [id])

  @@index([cartId])
}

// Independent per-instrument cap on a teacher's active (CONFIRMED/COMPLETED
// booking having occurred) student count - e.g. violin max 3, piano
// unlimited. maxActiveStudents null/absent = unlimited; an explicit 0 is a
// real cap (fully booked out), never treated as unlimited.
model TeacherInstrumentCapacity {
  id               String   @id @default(cuid())
  teacherProfileId String
  instrument       String
  maxActiveStudents Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@unique([teacherProfileId, instrument])
}

enum UnavailabilityLabel {
  UNAVAILABLE
  PRIVATE_APPOINTMENT
  HOLIDAY
  VACATION
  OTHER_UNAVAILABLE
}

// A teacher-declared block that overrides TeacherAvailability for a
// specific date/time range - one-time only for now (see the comment on
// Phase 3 scope in docs/development.md); recurring unavailability and full
// RFC 5545 recurrence for both availability and unavailability is later
// follow-up work, not implemented here. Overlapping this range removes it
// from bookable slot discovery; an existing booking inside the range is
// NOT auto-cancelled (see cancelBooking / the conflict check in
// bookings.ts) - conflict resolution stays a manual, explicit teacher
// action, never a silent cancellation of a paid booking.
model TeacherUnavailability {
  id               String              @id @default(cuid())
  teacherProfileId String
  startsAt         DateTime
  endsAt           DateTime
  // The only thing ever shown to students/guests - see the enum above.
  // Never expose `note` (below) to anyone but the teacher/an admin.
  label            UnavailabilityLabel @default(UNAVAILABLE)
  // Private detail only the teacher (and an admin) can see - never
  // resolved to students, matching the "never expose private appointment
  // titles/descriptions" requirement.
  note             String?
  createdAt        DateTime            @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@index([teacherProfileId, startsAt, endsAt])
}

// A user's own private appointment - visible only to them, never to anyone
// else including their own teacher/students. Distinct from Booking
// (platform lesson) and TeacherUnavailability (a teacher's declared block);
// this is personal calendar content that layers on top for the owning user
// only.
model PersonalAppointment {
  id        String   @id @default(cuid())
  userId    String
  title     String
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, startsAt, endsAt])
}

// Phase 6 (scoped): the OAuth-backed direction of calendar sync (reading a
// user's busy time FROM Google/Microsoft, to block their teacher
// availability against events on their external calendar). This is the
// schema/adapter *contract* only - CLAUDE.md's guardrail is deliberate
// ("Google Calendar / Meet integration is intentionally not in scope for
// now... do not add Google Calendar coupling unless a task explicitly
// reintroduces it"), so a live OAuth flow, token storage, and background
// sync are NOT implemented here. connectExternalCalendar
// (apps/api/src/resolvers/externalCalendar.ts) always rejects with
// NOT_CONFIGURED - there is no GOOGLE_CALENDAR_CLIENT_ID/
// MICROSOFT_CALENDAR_CLIENT_ID anywhere in this codebase or deploy
// manifests, and none should be fabricated. A row can only exist here once
// that OAuth implementation is a separate, explicitly-scoped task.
enum ExternalCalendarProvider {
  GOOGLE
  MICROSOFT
}

enum ExternalCalendarConnectionStatus {
  CONNECTED
  ERROR
}

model ExternalCalendarConnection {
  id                    String                            @id @default(cuid())
  userId                String
  provider              ExternalCalendarProvider
  status                ExternalCalendarConnectionStatus   @default(CONNECTED)
  externalAccountEmail  String?
  // Deliberately no access/refresh token columns yet - there is no OAuth
  // exchange in this codebase to produce one (see the model comment above).
  // Add them alongside the real token-exchange implementation, not before.
  lastSyncedAt          DateTime?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt

  user          User                    @relation(fields: [userId], references: [id])
  busyIntervals ExternalBusyInterval[]

  @@unique([userId, provider])
}

// One synced "don't book me here" block from an external calendar. Never
// populated today (see ExternalCalendarConnection above) - the shape exists
// so a future real sync job has a landing table without a schema change.
model ExternalBusyInterval {
  id           String   @id @default(cuid())
  connectionId String
  startsAt     DateTime
  endsAt       DateTime
  fetchedAt    DateTime @default(now())

  connection ExternalCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startsAt])
}

model Event {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  description      String?
  type             EventType
  format           EventFormat
  instruments      String[]
  musicStyles      String[]
  skillLevels      String[]
  thumbnailUrl     String?
  videoStreamUrl   String?
  startsAt         DateTime
  endsAt           DateTime?
  timezone         String      @default("Europe/Zurich")
  venueName        String?
  venueAddress     String?
  city             String?
  country          String?
  latitude         Float?
  longitude        Float?
  onlineMeetingUrl String?
  price            Decimal     @default(0) @db.Decimal(10, 2)
  currency         String      @default("CHF")
  maxCapacity      Int?
  currentCapacity  Int         @default(0)
  isPublished      Boolean     @default(false)
  publisherId      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  publisher User           @relation(fields: [publisherId], references: [id])
  bookings  EventBooking[]
  reviews   Review[]
}

model EventBooking {
  id              String             @id @default(cuid())
  userId          String?
  eventId         String
  status          EventBookingStatus @default(PENDING)
  paymentId       String?            @unique
  bookedAt        DateTime           @default(now())
  pretixOrderCode String?            @unique
  email           String?
  total           Float?
  currency        String?
  checkedIn       Boolean            @default(false)

  user    User?    @relation(fields: [userId], references: [id])
  event   Event    @relation(fields: [eventId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([userId, eventId])
}

model Payment {
  id          String          @id @default(cuid())
  userId      String
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("CHF")
  status      PaymentStatus   @default(PENDING)
  provider    PaymentProvider
  providerRef String?
  providerPaymentIntentId String?
  providerChargeId String?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  // Durable "payment-stage notification dispatched" marker for the Stripe
  // handler. A retried delivery checks this instead of "did I just create
  // the Payment row," so a delivery that created the row but crashed before setting
  // this still gets a real retry at sending the confirmation, rather than
  // silently never sending one (the gap an isNewPayment-only heuristic had).
  confirmationEmailAt DateTime?

  user         User          @relation(fields: [userId], references: [id])
  enrollment   Enrollment?
  eventBooking EventBooking?
  checkoutOrder CheckoutOrder?

  // The real idempotency guard for handleStripeWebhook (payments.ts) -
  // concurrent/retried deliveries of the same checkout session race a
  // findFirst-then-create check, but a unique constraint makes the second
  // create fail atomically instead of slipping through. Postgres treats
  // each NULL providerRef as distinct, so non-webhook-created payments
  // (providerRef left unset) never collide with each other under this.
  @@unique([provider, providerRef])
}

model CheckoutOrder {
  id                      String                @id @default(cuid())
  userId                  String
  teacherProfileId        String?
  cartId                  String?               @unique
  paymentId               String?               @unique
  status                  CheckoutOrderStatus   @default(PENDING)
  amount                  Decimal               @db.Decimal(10, 2)
  currency                String                @default("CHF")
  stripeCheckoutSessionId String?               @unique
  stripePaymentIntentId   String?
  stripeChargeId          String?
  teacherTransferStatus   TeacherTransferStatus @default(NOT_REQUIRED)
  teacherTransferDueAt    DateTime?
  stripeTransferId        String?
  refundedAt              DateTime?
  cancellationReason      String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  teacherProfile TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  cart           BookingCart?    @relation(fields: [cartId], references: [id])
  payment        Payment?        @relation(fields: [paymentId], references: [id])
  items          CheckoutOrderItem[]
  bookings       Booking[]

  @@index([userId, status])
  @@index([teacherProfileId, status])
}

model CheckoutOrderItem {
  id          String                @id @default(cuid())
  orderId     String
  type        CheckoutOrderItemType
  refId       String?
  description String
  quantity    Int                   @default(1)
  unitAmount  Decimal               @db.Decimal(10, 2)
  totalAmount Decimal               @db.Decimal(10, 2)
  metadata    Json?
  createdAt   DateTime              @default(now())

  order CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ── Phase 5 (scoped): prepaid lesson packages, upfront-term subscriptions,
// course bundling. True monthly recurring billing (Stripe Subscription
// objects with dunning/proration) is out of scope for this phase - both
// product types here are single upfront Stripe Checkout payments, reusing
// the existing createCheckoutSession/handleStripeWebhook type-dispatch
// pattern rather than a second payment integration. See
// apps/api/src/lib/pricing.ts for the discount/rounding math.

// A teacher-published prepaid package offer (5/10/20 one-hour lessons).
// Unpublishing/editing never touches existing LessonPackagePurchase rows -
// every commercial term a student actually paid is snapshotted onto the
// purchase at checkout time.
model LessonPackageOffer {
  id               String   @id @default(cuid())
  teacherProfileId String
  instrument       String?
  lessonCount      Int
  pricePerPackage  Decimal  @db.Decimal(10, 2)
  currency         String   @default("CHF")
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacherProfile TeacherProfile          @relation(fields: [teacherProfileId], references: [id])
  purchases      LessonPackagePurchase[]
}

// Snapshot of everything that mattered at checkout time - name/inclusions/
// price/policy - so a later teacher edit to LessonPackageOffer or their
// default leadDays/cancellationDays never retroactively changes what this
// student already bought.
model LessonPackagePurchase {
  id                     String    @id @default(cuid())
  userId                 String
  teacherProfileId       String
  offerId                String?
  instrument             String?
  lessonCount            Int
  pricePaid              Decimal   @db.Decimal(10, 2)
  currency               String
  policyLeadDays         Int
  policyCancellationDays Int
  // Plain column, no FK - same pattern Booking.paymentId already uses
  // (Payment has no reverse relation declared to keep this one-directional).
  paymentId              String?   @unique
  status                 LessonPackagePurchaseStatus @default(ACTIVE)
  refundableUntil        DateTime?
  firstUsedAt            DateTime?
  includedCourseCredits  Int       @default(0)
  usedCourseCredits      Int       @default(0)
  purchasedAt            DateTime  @default(now())

  user           User                     @relation(fields: [userId], references: [id])
  teacherProfile TeacherProfile           @relation(fields: [teacherProfileId], references: [id])
  offer          LessonPackageOffer?      @relation(fields: [offerId], references: [id])
  ledgerEntries  LessonCreditLedgerEntry[]
}

enum LessonCreditEntryType {
  GRANT
  CONSUME
  RESTORE
  EXPIRE
  ADJUST
}

// Signed ledger, never mutated in place - the credit balance for a
// purchase is always SUM(amount) over its entries (GRANT/RESTORE positive,
// CONSUME/EXPIRE negative), auditable end to end. See
// apps/api/src/lib/lessonCredits.ts.
model LessonCreditLedgerEntry {
  id         String                @id @default(cuid())
  purchaseId String
  type       LessonCreditEntryType
  amount     Int
  bookingId  String?
  note       String?
  createdAt  DateTime              @default(now())

  purchase LessonPackagePurchase @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
}

// A teacher-published fixed-term subscription offer. termMonths is 6 or 12
// (validated in the resolver); the upfront discount for each term is a
// stored AdminSetting (subscription_discount_pct_6mo /
// subscription_discount_pct_12mo, defaulting to 10/25) so the business can
// change the default without touching any SubscriptionPurchase already
// sold at the old rate.
model SubscriptionOffer {
  id                    String   @id @default(cuid())
  teacherProfileId      String
  includedHoursPerMonth Int
  termMonths            Int
  monthlyPrice          Decimal  @db.Decimal(10, 2)
  currency              String   @default("CHF")
  // Course entitlements bundled with this subscription - the existing
  // Enrollment model is the actual entitlement; these ids just say which
  // courses to enroll into on purchase.
  includedCourseIds     String[] @default([])
  isPublished           Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  teacherProfile TeacherProfile         @relation(fields: [teacherProfileId], references: [id])
  purchases      SubscriptionPurchase[]
}

enum SubscriptionPurchaseStatus {
  ACTIVE
  CANCELLED_AT_PERIOD_END
  CANCELLED
  EXPIRED
}

model SubscriptionPurchase {
  id                     String                     @id @default(cuid())
  userId                 String
  teacherProfileId       String
  offerId                String?
  termMonths             Int
  includedHoursPerMonth  Int
  monthlyPrice           Decimal                    @db.Decimal(10, 2)
  discountPct            Int
  totalPricePaid         Decimal                    @db.Decimal(10, 2)
  currency               String
  includedCourseIds      String[]                   @default([])
  includedCourseCredits  Int                        @default(0)
  usedCourseCredits      Int                        @default(0)
  includedEventCredits   Int                        @default(0)
  usedEventCredits       Int                        @default(0)
  policyLeadDays         Int
  policyCancellationDays Int
  paymentId              String?                    @unique
  status                 SubscriptionPurchaseStatus @default(ACTIVE)
  startsAt               DateTime                   @default(now())
  endsAt                 DateTime
  cancelledAt            DateTime?
  cancellationEffectiveAt DateTime?
  monthlyCapHours        Int                        @default(10)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  teacherProfile TeacherProfile  @relation(fields: [teacherProfileId], references: [id])
  offer          SubscriptionOffer? @relation(fields: [offerId], references: [id])
}

enum MailOutboxStatus {
  PENDING
  SENT
  FAILED
  DEAD_LETTER
}

enum MailOutboxKind {
  BOOKING_REQUEST
  BOOKING_CONFIRMATION
  BOOKING_CANCELLED
  EVENT_CONFIRMATION
  EVENT_CANCELLED
}

// Durable transactional-email outbox (see 021-mail-outbox.sql). A booking
// mutation writes a row here in the same transaction as the booking change
// it announces, instead of calling the SMTP relay synchronously - mail
// delivery failure or slowness must never fail or block the booking itself.
// apps/worker's mail-dispatch job polls PENDING/due rows and delivers with
// retry/backoff; a message that exhausts maxAttempts becomes DEAD_LETTER,
// which admins can see via Query.mailOutbox rather than the notification
// silently vanishing.
model MailOutboxMessage {
  id            String           @id @default(cuid())
  kind          MailOutboxKind
  bookingId      String?
  eventBookingId String?
  recipients    String[]
  subject       String
  html          String
  // Optional RFC 5545 calendar invitation attached to this message (see
  // apps/api/src/lib/ics.ts) - icsMethod is 'REQUEST' (create/update) or
  // 'CANCEL', matching the VEVENT's own METHOD so calendar clients apply
  // it correctly rather than just showing an .ics file attachment.
  icsContent    String?
  icsMethod     String?
  status        MailOutboxStatus @default(PENDING)
  attempts      Int              @default(0)
  maxAttempts   Int              @default(8)
  lastError     String?
  nextAttemptAt DateTime         @default(now())
  sentAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, nextAttemptAt])
  @@index([bookingId])
  @@index([eventBookingId])
}

model FeedPost {
  id         String   @id @default(cuid())
  authorId   String
  content    String
  mediaUrls  String[]
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  likes    FeedLike[]
  comments FeedComment[]
}

model FeedLike {
  id     String @id @default(cuid())
  userId String
  postId String

  user User     @relation(fields: [userId], references: [id])
  post FeedPost @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model FeedComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  post   FeedPost @relation(fields: [postId], references: [id])
  author User     @relation(fields: [authorId], references: [id])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id])
  following User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String?
  eventId   String?
  bookingId String?  @unique
  rating    Int
  body      String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())

  // A student's evaluation of an external (Classictic/Ticketmaster) event
  // they attended - gated on ExternalEventEngagement.attendanceConfirmedAt
  // being set first (see reviews.ts createReview), same spirit as
  // bookingId requiring status COMPLETED above. Many different students
  // can each review the same external event once - see the compound
  // unique on ExternalEventEngagement instead of a plain unique column here.
  externalEventProjectionId String?

  user    User     @relation(fields: [userId], references: [id])
  course  Course?  @relation(fields: [courseId], references: [id])
  event   Event?   @relation(fields: [eventId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  externalEventProjection ExternalEventProjection? @relation(fields: [externalEventProjectionId], references: [id])
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ── External event discovery (read-only projections) ────────────────────────────────────────────────────────────────
// Cached, normalized rows from external providers (Ticketmaster now, Classictic
// later). Kept separate from Event: these are discovery inputs, never authored
// content, and never enter the authored-event publishing flow.

enum ExternalEventProvider {
  TICKETMASTER
  CLASSICTIC
}

model ExternalEventProjection {
  id              String                @id @default(cuid())
  provider        ExternalEventProvider
  providerId      String
  title           String
  description     String?
  url             String // provider deep/affiliate link — the only purchase path
  imageUrl        String?
  startsAt        DateTime
  endsAt          DateTime?
  timezone        String?
  venueName       String?
  city            String?
  country         String?
  latitude        Float?
  longitude       Float?
  minPrice        Decimal?              @db.Decimal(10, 2)
  maxPrice        Decimal?              @db.Decimal(10, 2)
  currency        String?
  classifications String[] // normalized genres/styles, as provided by the source
  attribution     String // required provider attribution string
  raw             Json? // raw payload for debugging; not shown to users
  fetchedAt       DateTime
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Provider genre tags (`classifications`) aren't aligned to this
  // platform's taxonomy - a Ticketmaster "Classical" tag says nothing about
  // instrument or skill level. These are populated by the DeepSeek
  // event-classification worker job from title/description/classifications,
  // matching the same dimensions used to filter/recommend native Events.
  // classifiedAt is null until the job has processed a row at least once
  // (empty tag arrays are a valid classification outcome, not "unprocessed").
  instruments  String[] @default([])
  musicStyles  String[] @default([])
  skillLevels  String[] @default([])
  classifiedAt DateTime?

  @@unique([provider, providerId])
  @@index([startsAt])
  @@index([city])
  @@index([classifiedAt])

  engagements ExternalEventEngagement[]
  reviews     Review[]
}

// One row per (user, external event) - "recently visited" for a profile
// page is just this ordered by lastViewedAt. attendanceConfirmedAt gates
// leaving a Review (see reviews.ts); xpAwardedAt is a durable marker
// alongside awardXpOnce's own idempotency guard, kept for admin
// visibility into whether/when XP was actually granted for this event.
model ExternalEventEngagement {
  id                        String    @id @default(cuid())
  userId                    String
  externalEventProjectionId String
  firstViewedAt             DateTime  @default(now())
  lastViewedAt              DateTime  @default(now())
  // Only settable once the event has actually started (see
  // confirmExternalEventAttendance) - self-reported, same trust level as
  // any other attendance confirmation without a scanned ticket.
  attendanceConfirmedAt     DateTime?
  xpAwardedAt               DateTime?

  user                    User                    @relation(fields: [userId], references: [id])
  externalEventProjection ExternalEventProjection @relation(fields: [externalEventProjectionId], references: [id])

  @@unique([userId, externalEventProjectionId])
  @@index([userId, lastViewedAt])
}
