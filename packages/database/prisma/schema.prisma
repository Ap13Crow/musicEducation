generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SkillLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonContentType {
  VIDEO
  YOUTUBE
  AUDIO
  SLIDES
}

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum QuizFeedbackMode {
  IMMEDIATE
  AT_END
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum EventType {
  MASTERCLASS
  WORKSHOP
  CONCERT
  COMPETITION
  OPEN_MIC
  LECTURE
  OTHER
}

enum EventFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  YAPEAL
}

enum EventBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  ATTENDED
}

enum TeacherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Models ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  credential         UserCredential?
  profile            UserProfile?
  teacherProfile     TeacherProfile?
  teacherApplication TeacherApplication?
  gamification       GamificationProfile?
  externalIdentities UserExternalIdentity[]
  enrollments        Enrollment[]
  bookings           Booking[]
  eventBookings      EventBooking[]
  payments           Payment[]
  assessments        Assessment[]
  feedPosts          FeedPost[]
  feedLikes          FeedLike[]
  feedComments       FeedComment[]
  following          Follow[]               @relation("follower")
  followers          Follow[]               @relation("following")
  reviews             Review[]
  publishedEvents     Event[]
  studentAvailability StudentAvailability[]
  quizAttempts        QuizAttempt[]
  xpAwards            XpAward[]
}

model UserCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model UserProfile {
  id             String     @id @default(cuid())
  userId         String     @unique
  displayName    String?
  bio            String?
  avatarUrl      String?
  instruments    String[]
  musicStyles    String[]
  skillLevel     SkillLevel @default(BEGINNER)
  city           String?
  country        String?
  language       String     @default("en")
  timezone       String     @default("Europe/Zurich")
  onboardingDone Boolean    @default(false)
  onboardingStep Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model TeacherProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  bio              String?
  instruments      String[]
  musicStyles      String[]
  languages        String[]
  hourlyRate       Decimal? @db.Decimal(10, 2)
  currency         String   @default("CHF")
  isAvailable      Boolean  @default(true)
  calendlyUsername String?
  avgRating        Float    @default(0)
  totalReviews     Int      @default(0)
  // Copied from the approved TeacherApplication - years teaching, and a
  // YouTube presentation/performance video the teacher can hide again at
  // any time (introVideoVisible) without losing the link itself.
  experienceYears    Int?
  introVideoUrl      String?
  introVideoVisible  Boolean  @default(true)
  // Stripe Connect Express account this teacher's share of course/booking/event
  // revenue is transferred to. Null until the teacher completes onboarding.
  stripeAccountId      String?  @unique
  stripePayoutsEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User                   @relation(fields: [userId], references: [id])
  certifications TeacherCertification[]
  availability   TeacherAvailability[]
  courses        Course[]
  bookings       Booking[]
}

model TeacherCertification {
  id               String   @id @default(cuid())
  teacherProfileId String
  title            String
  issuingBody      String?
  issuedYear       Int?
  documentUrl      String?
  createdAt        DateTime @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])
}

// A student's self-service request to become a teacher. Approving one is the
// only thing that promotes User.role to TEACHER via this path — admins can
// still promote directly via adminSetRole, but the public "Become a teacher"
// page always goes through this queue for review.
model TeacherApplication {
  id              String                    @id @default(cuid())
  userId          String                    @unique
  headline        String?
  bio             String?
  instruments     String[]
  experienceYears Int?
  // Verified server-side (applyForTeacher rejects under-18) - self-employed
  // teachers on the platform must be adults; full identity verification is a
  // later phase, this is the quality/legal floor for now.
  address         String?
  birthdate       DateTime?                 @db.Date
  // Private, admin-review-only - never copied onto the public TeacherProfile.
  gender          String?
  motivation      String?
  // Object storage URLs (see apps/api/src/lib/storage.ts) - populated via
  // requestUploadUrl(purpose: TEACHER_APPLICATION_*) then attached here on
  // submit. Never inline file data.
  cvUrl           String?
  audioSampleUrl  String?
  documentUrls    String[]                  @default([])
  // YouTube link, not an uploaded file - keeps the site light (see
  // apps/web/src/lib/youtube.ts). Required to apply; copied to
  // TeacherProfile.introVideoUrl on approval.
  videoUrl        String?
  status          TeacherApplicationStatus  @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model TeacherAvailability {
  id               String   @id @default(cuid())
  teacherProfileId String
  dayOfWeek        Int
  startTime        String
  endTime          String
  timezone         String   @default("Europe/Zurich")
  createdAt        DateTime @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])
}

model StudentAvailability {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int      // 0=Sun … 6=Sat
  startTime String   // "HH:MM"
  endTime   String   // "HH:MM"
  timezone  String   @default("Europe/Zurich")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model GamificationProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  xp          Int        @default(0)
  totalPoints Int        @default(0)
  level       Int        @default(1)
  skillLevel  SkillLevel @default(BEGINNER)
  badges      String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum XpAwardReason {
  PROFILE_COMPLETED
  TEACHER_FOUND
  EVENT_ATTENDED
  COURSE_BONUS
}

// Audit ledger for every XP grant outside per-lesson (Lesson.xpReward) and
// assessment (Assessment.xpAwarded) completion, which already increment
// GamificationProfile directly. refId is the idempotency key for the
// automatic one-time reasons (PROFILE_COMPLETED/TEACHER_FOUND use the
// sentinel 'self'; EVENT_ATTENDED uses the event id) - the unique
// constraint below relies on Postgres treating NULL <> NULL, so
// COURSE_BONUS (refId always null) is deliberately exempt and stays
// repeatable, since a teacher/admin may award it more than once.
model XpAward {
  id           String        @id @default(cuid())
  userId       String
  reason       XpAwardReason
  refId        String?
  enrollmentId String?
  amount       Int
  note         String?
  awardedBy    String?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, reason, refId])
  @@index([userId])
}

model UserExternalIdentity {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  externalId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, externalId])
}

model Category {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  courses  Course[]
}

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  description      String?
  shortSummary     String?
  level            SkillLevel   @default(BEGINNER)
  instruments      String[]
  musicStyles      String[]
  price            Decimal      @default(0) @db.Decimal(10, 2)
  currency         String       @default("CHF")
  status           CourseStatus @default(DRAFT)
  isFreeTier       Boolean      @default(false)
  language         String       @default("en")
  thumbnailUrl     String?
  categoryId       String?
  teacherProfileId String?
  moodleCourseId   Int?
  avgRating        Float        @default(0)
  totalReviews     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  teacherProfile TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  sections       CourseSection[]
  enrollments    Enrollment[]
  reviews        Review[]
}

model CourseSection {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int    @default(0)

  course  Course   @relation(fields: [courseId], references: [id])
  lessons Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  sectionId   String
  title        String
  description  String?
  videoUrl     String?
  contentType  LessonContentType @default(VIDEO)
  duration     Int?
  order        Int      @default(0)
  xpReward     Int      @default(10)
  isPreview    Boolean  @default(false)
  feedbackMode QuizFeedbackMode @default(IMMEDIATE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  section       CourseSection    @relation(fields: [sectionId], references: [id])
  progress      LessonProgress[]
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]
  slides        LessonSlide[]
}

// Ordered slide deck for a contentType SLIDES lesson - each slide its own
// uploaded file (image or single-page PDF) in object storage, rather than a
// single PDF split server-side, so per-slide viewing can be tracked without
// a PDF-rendering pipeline.
model LessonSlide {
  id        String   @id @default(cuid())
  lessonId  String
  order     Int      @default(0)
  fileUrl   String
  title     String?
  createdAt DateTime @default(now())

  lesson Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  views  LessonSlideView[]

  @@index([lessonId, order])
}

// Per-slide "viewed" marker for one student's enrollment - drives
// Lesson.myViewedSlideIds and the slide viewer's progress bar. Idempotent
// per (enrollment, slide): viewing a slide again is a no-op, not a new row.
model LessonSlideView {
  id           String   @id @default(cuid())
  enrollmentId String
  slideId      String
  viewedAt     DateTime @default(now())

  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  slide      LessonSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, slideId])
}

model QuizQuestion {
  id          String           @id @default(cuid())
  lessonId    String
  text        String
  type        QuizQuestionType @default(SINGLE_CHOICE)
  points      Int              @default(1)
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lesson  Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]
}

model QuizOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  score       Int       @default(0)
  maxScore    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([userId, lessonId])
}

model QuizAnswer {
  id                String   @id @default(cuid())
  attemptId         String
  questionId        String
  selectedOptionIds String[] @default([])
  isCorrect         Boolean  @default(false)
  pointsAwarded     Int      @default(0)
  answeredAt        DateTime @default(now())

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  paymentId   String?   @unique
  progress    Float     @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User              @relation(fields: [userId], references: [id])
  course         Course            @relation(fields: [courseId], references: [id])
  payment        Payment?          @relation(fields: [paymentId], references: [id])
  lessonProgress LessonProgress[]
  slideViews     LessonSlideView[]

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  lesson     Lesson     @relation(fields: [lessonId], references: [id])

  @@unique([enrollmentId, lessonId])
}

model Assessment {
  id          String    @id @default(cuid())
  userId      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationSec Int?
  skillLevel  String?
  xpAwarded   Int?
  aiReport    String?
  createdAt   DateTime  @default(now())

  user    User               @relation(fields: [userId], references: [id])
  answers AssessmentAnswer[]
}

model AssessmentQuestion {
  id         String   @id @default(cuid())
  category   String
  difficulty String
  instrument String?
  prompt     String
  options    Json?
  createdAt  DateTime @default(now())

  answers AssessmentAnswer[]
}

model AssessmentAnswer {
  id             String   @id @default(cuid())
  assessmentId   String
  questionId     String
  selectedOption String?
  openAnswer     String?
  isCorrect      Boolean?
  createdAt      DateTime @default(now())

  assessment Assessment         @relation(fields: [assessmentId], references: [id])
  question   AssessmentQuestion @relation(fields: [questionId], references: [id])

  // Revisiting a question (e.g. going back a step) must update the existing
  // answer, not add a second row - completeAssessment scores off
  // assessment.answers.length, so a duplicate would inflate totalAnswered
  // and silently skew the resulting score/skill level.
  @@unique([assessmentId, questionId])
}

model Booking {
  id               String        @id @default(cuid())
  userId           String
  teacherProfileId String
  startsAt         DateTime
  endsAt           DateTime?
  durationMin      Int           @default(60)
  format           BookingFormat @default(ONLINE)
  status           BookingStatus @default(PENDING)
  paymentId        String?
  instrument       String?
  notes            String?
  meetingUrl       String?
  zoomMeetingId    String?
  zoomJoinUrl      String?
  zoomStartUrl     String?
  externalBookingId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  reviews        Review[]
}

model Event {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  description      String?
  type             EventType
  format           EventFormat
  instruments      String[]
  musicStyles      String[]
  skillLevels      String[]
  thumbnailUrl     String?
  videoStreamUrl   String?
  startsAt         DateTime
  endsAt           DateTime?
  timezone         String      @default("Europe/Zurich")
  venueName        String?
  venueAddress     String?
  city             String?
  country          String?
  latitude         Float?
  longitude        Float?
  onlineMeetingUrl String?
  price            Decimal     @default(0) @db.Decimal(10, 2)
  currency         String      @default("CHF")
  maxCapacity      Int?
  currentCapacity  Int         @default(0)
  isPublished      Boolean     @default(false)
  publisherId      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  publisher User           @relation(fields: [publisherId], references: [id])
  bookings  EventBooking[]
  reviews   Review[]
}

model EventBooking {
  id              String             @id @default(cuid())
  userId          String?
  eventId         String
  status          EventBookingStatus @default(PENDING)
  paymentId       String?            @unique
  bookedAt        DateTime           @default(now())
  pretixOrderCode String?            @unique
  email           String?
  total           Float?
  currency        String?
  checkedIn       Boolean            @default(false)

  user    User?    @relation(fields: [userId], references: [id])
  event   Event    @relation(fields: [eventId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([userId, eventId])
}

model Payment {
  id          String          @id @default(cuid())
  userId      String
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("CHF")
  status      PaymentStatus   @default(PENDING)
  provider    PaymentProvider
  providerRef String?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  enrollment   Enrollment?
  eventBooking EventBooking?
}

model FeedPost {
  id         String   @id @default(cuid())
  authorId   String
  content    String
  mediaUrls  String[]
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  likes    FeedLike[]
  comments FeedComment[]
}

model FeedLike {
  id     String @id @default(cuid())
  userId String
  postId String

  user User     @relation(fields: [userId], references: [id])
  post FeedPost @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model FeedComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  post   FeedPost @relation(fields: [postId], references: [id])
  author User     @relation(fields: [authorId], references: [id])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id])
  following User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String?
  eventId   String?
  bookingId String?  @unique
  rating    Int
  body      String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  course  Course?  @relation(fields: [courseId], references: [id])
  event   Event?   @relation(fields: [eventId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ── External event discovery (read-only projections) ──────────────────────────
// Cached, normalized rows from external providers (Ticketmaster now, Classictic
// later). Kept separate from Event: these are discovery inputs, never authored
// content, and never enter the authored-event publishing flow.

enum ExternalEventProvider {
  TICKETMASTER
  CLASSICTIC
}

model ExternalEventProjection {
  id              String                @id @default(cuid())
  provider        ExternalEventProvider
  providerId      String
  title           String
  description     String?
  url             String // provider deep/affiliate link — the only purchase path
  imageUrl        String?
  startsAt        DateTime
  endsAt          DateTime?
  timezone        String?
  venueName       String?
  city            String?
  country         String?
  latitude        Float?
  longitude       Float?
  minPrice        Decimal?              @db.Decimal(10, 2)
  maxPrice        Decimal?              @db.Decimal(10, 2)
  currency        String?
  classifications String[] // normalized genres/styles, as provided by the source
  attribution     String // required provider attribution string
  raw             Json? // raw payload for debugging; not shown to users
  fetchedAt       DateTime
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Provider genre tags (`classifications`) aren't aligned to this
  // platform's taxonomy - a Ticketmaster "Classical" tag says nothing about
  // instrument or skill level. These are populated by the DeepSeek
  // event-classification worker job from title/description/classifications,
  // matching the same dimensions used to filter/recommend native Events.
  // classifiedAt is null until the job has processed a row at least once
  // (empty tag arrays are a valid classification outcome, not "unprocessed").
  instruments  String[] @default([])
  musicStyles  String[] @default([])
  skillLevels  String[] @default([])
  classifiedAt DateTime?

  @@unique([provider, providerId])
  @@index([startsAt])
  @@index([city])
  @@index([classifiedAt])
}
